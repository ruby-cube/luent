// - [ ] Access ref/model vs pass in callback or  model
//     - [ ] Shared state
//     - [ ] Child state only
//     - [ ] Shared control
//     - [ ] Single control

// child owns state
// - child controls state
//   > provide hooks
// - child exposes control over state

// shared state external entity owns/implements state
// - child permitted to control state via mu: and methods, or model
// - child merely displays state, doesn't control it (reactive attributes)

// Who owns the state just depends on what conceptually makes the most sense



import { FromTag, If, NodeRef, template } from "@rue/luent";
import { Ion, Ionic } from "@rue/quarky";

// Case 1: Child maintains local state but is completedly controlled by Parent via ref
function ControllingParent() {
   get controlled = NodeRef(Controlled)

   return template(
      <div>
         <Controlled ref={controlled@}></Controlled>
      </div>
   )
}

function Controlled() {
   get open = ion(false, {
      toggle() {
         open@.value = !open
      }
   })

   return template(
      <div>
         {If(open@,
            <div>hi</div>
         )}
      </div>
   )
      .ref({
         toggle: open@.toggle
      })
}

// Case 2: Child maintains local state, but changes its own state as well as allows Parent to change its state
function SharedControllingParent() {
   get controlled = NodeRef(Controlled)

   return template(
      <div>
         <Controlled ref={controlled@}></Controlled>
      </div>
   )
}

function SharedControlled(input: FromTag<{
   'on:close': () => void
}>) {
   get open = ion(false, {
      toggle() {
         open@.value = !open
      }
   })

   return template(
      <div>
         {If(open@,
            <>
               <div>hi</div>
               <button on:click={open@.toggle}></button>
            </>
         )}
      </div>
   )
      .ref({
         toggle: open@.toggle
      })
}

function Parent() {
   const child = ChildA.Model()

   get childB = NodeRef(ChildB)

   function reClick() {
      child.focus()

      childB?.focus()
   }

   return template(
      <div>
         <ChildA mu:model={child}></ChildA>
         <ChildB ref={childB@}></ChildB>
      </div>
   )
}


function ChildA(input: FromTag<{
   model?: ChildModel
   count: Ion<number>
}>) {
   const { model = { box@: NodeRef('div') } } = input;
   get { box } = model

   return template(
      <div>
         <div ref={box@}></div>
      </div>
   )
}

type ChildModel = ReturnType<typeof ChildA.Model>

ChildA.Model = () => {
   get box = NodeRef('div')

   return {
      box@,
      focus() {
         box?.focus()
      }
   }
}




function ChildB(input: FromTag<{}>) {
   get box = NodeRef('div')

   return template(
      <div>
         <div ref={box@}></div>
      </div>
   )
      .ref({
         focus() {
            box?.focus()
         }
      })
}



// Forward Ref vs Component Ref

function StyledComp() {
   get div = NodeRef('div')

   return template(
      <BaseComp ref={div@}></BaseComp>
   )
}

function BaseComp(input: FromTag<{
   ref: NodeRef<'div'>
}>) {

   return template(
      <div {...input}></div>
   )
}