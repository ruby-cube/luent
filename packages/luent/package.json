{
   "name": "luent",
   "private": false,
   "version": "0.0.1",
   "description": "An expressive framework for building web applications with clarity and flow",
   "repository": {
      "type": "git",
      "url": "git+https://github.com/ruby-cube/luent.git"
   },
   "type": "module",
   "exports": {
      ".": {
         "workspace": "./src/index.ts",
         "default": "./dist/index.mjs"
      },
      "./jsx-runtime": {
         "workspace": "./src/jsx-runtime/index.ts",
         "default": "./dist/jsx-runtime.mjs"
      },
      "./jsx-dev-runtime": {
         "workspace": "./src/jsx-runtime/index.ts",
         "default": "./dist/jsx-runtime.mjs"
      }
   },
   "main": "./dist/index.mjs",
   "module": "./dist/index.mjs",
   "files": [
      "dist"
   ],
   "scripts": {
      "build": "pnpm run build:js && pnpm run build:dts",
      "build:js": "tsdown",
      "build:dts": "node ./scripts/copy-dts.mjs",
      "watch": "tsdown --watch",
      "prepack": "pnpm run build",
      "pack": "pnpm pack",
      "publish:dry": "pnpm publish --dry-run --no-git-checks",
      "publish:public": "pnpm publish --no-git-checks"
   },
   "devDependencies": {
      "@luent/flask": "workspace:*",
      "@luent/nextscript": "workspace:*",
      "@luent/quarky": "workspace:*",
      "@luent/types": "workspace:*",
      "@luent/utils": "workspace:*",
      "tsdown": "^0.21.9",
      "typescript": "^6.0.3"
   },
   "publishConfig": {
      "access": "public"
   },
   "author": "Ruby Yi Wang",
   "license": "MIT"
}
