{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "jsx": "preserve",
    "paths": {
      "luent/jsx-runtime": [
        "../luent/src/jsx-runtime/index.ts"
      ],
      "luent/jsx-dev-runtime": [
        "../luent/src/jsx-runtime/index.ts"
      ]
    },
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationMap": false,
    "noCheck": true,
    "types": [],
    "rootDir": ".",
    "outDir": "./dist/types",
    "composite": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo/utils.dts.tsbuildinfo"
  },
  "include": [
    "../env.d.ts",
    "./index.ts",
    "./*.ts"
  ],
  "exclude": [
    "./src/**",
    "./**/__tests__/**",
    "./**/*.test.ts",
    "./**/*.test.tsx"
  ],
  "references": [
    { "path": "../types/tsconfig.build.json" }
  ]
}
