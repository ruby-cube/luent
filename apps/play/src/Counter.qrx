//       return {
//          get halfCount: Ion(() => count / 2),
//          get thirdCount: Ion(() => count / 3)
//       }
// }


function FractionKit(count@: Ion<number>) {

   return {
      halfCount@: Ion((count / 2)),
      thirdCount@: Ion((count / 3))
   }
}

export function QrxCounter({ showFractions@ }: FromTag<{ showFractions: MutableIon<boolean> }>) {

   get count = Ion(0, {
      increment() {
         count@.value++
      }
   })
   get doubleCount = Ion(() => count * 2)

   const kit = FractionKit(count@);
   get halfCount = kit.halfCount@
   get thirdCount = kit.thirdCount@

   function doSomething(count: number) {
      console.log('count', count)
   }

   doSomething(count)

   function other(count: number) {
      console.log('counter',
         //@ts-expect-error
         cout
      )
   }

   let dog;

   get obj = Ion({ name: 'kermit' } as { name: string } | undefined)

   function doSomethingElse() {
      if (dog) {

      }
      else if (obj) {
         const name = obj.name
         console.log('name', obj, name)
      }
      else {
         obj.name
         console.log('nothing')
      }
   }

   doSomethingElse()

   return template(
      <div>
         <button on:click={e => count@.increment()}>+</button>
         <p>start: {count}</p>
         <p>count: {count@}</p>
         <p>doubleCount: {doubleCount@}</p>
         <p>tripleCount: {(count * 3)}</p>
         <button on:click={e => { showFractions@.value = !showFractions; showFractions ? obj@.value = undefined : obj@.value = { name: 'sir robin' } }}>{(showFractions ? 'hide' : 'show')} fractions</button>
         {/* {If(obj,
            <div>{obj.name}</div>
         )}
         {If(obj,
            <div>{(obj.name)}</div>
         )}
         {If(obj, () =>
            <div>{obj.name}</div>
         )}
         {If(obj@,
            <div>{obj.name}</div>
         )}
         {If(obj@,
            <div>{(obj.name)}</div>
         )}
         {If(obj@, () =>
            <div>{obj.name}</div>
         )} */}
         {If(showFractions@, (
            <hr></hr>
            <p> halfCount: {halfCount@}</p>
            <p> thirdCount: {thirdCount@}</p>
         ))}
      </div>
   )
}


export function TodoApp() {

   return template(
      <div></div>
   )
}



type Todo = { title: string; completed: boolean };

function TodoItem(title: string): Todo {
   return { title, completed: false };
}

export function RealWorldDemo() {

   return template(
    <div>
      <h2>RealWorld Todo Demo (.qrx)</h2>
      <input
        value={newTodo@}
        on:input={e => newTodo@.value = e.target.value}
        placeholder="Add a todo..."
      />
      <button on:click={addTodo}>Add</button>
      <div>
        <button on:click={() => (filter@.value = "all")}>All</button>
        <button on:click={() => (filter@.value = "active")}>Active</button>
        <button on:click={() => (filter@.value = "completed")
}> Completed</button >
      </div >
      <ul>
        {filteredTodos().map((todo: Todo) => (
          <li>
            <input type="checkbox" checked={todo.completed} on:change={() => toggle(todo)} />
            <span style={{ textDecoration: todo.completed ? "line-through" : "none" }}>{todo.title}</span>
            <button on:click={() => remove(todo)}>x</button>
          </li>
        ))}
      </ul>
      <div>
        <span>{activeTodos@.length} left</span>
        <span> / {todos@.length} total</span>
      </div>
    </div >
  );
}