
import { Ion, Ionic } from "@rue/quarky";
import { For, template } from "@rue/lumo";

type Todo = { title: string; completed: boolean };

function IonicTodoItem(title: string) {
   return (
      Ionic({ title, completed: false })
   )
}

export function QrxTodo() {
   get todos = Ion(Ionic([
      IonicTodoItem("Learn Rue"),
      IonicTodoItem("Build a demo"),
   ], {
      add() {
         if (newTodo.trim()) {
            todos.push(IonicTodoItem(newTodo));
            newTodo@.value = "";
         }
      },
      remove(todo: Ionic<Todo>) {
         const idx = todos.indexOf(todo);
         if (idx !== -1) todos.splice(idx, 1);
      }
   }))
   get activeTodos = Ion(() => todos.filter(todo => !todo.completed));
   get completedTodos = Ion(() => todos.filter(todo => todo.completed));

   get newTodo = Ion("");
   get filter = Ion("all" as 'all' | 'active' | 'completed');

   const filters = {
      all: todos@,
      active: activeTodos@,
      completed: completedTodos@
   }

   get filteredTodos = Ion(() => filters[filter]())

   return template(
      <div>
         <h2>Todos</h2>
         <input
            mu:value={newTodo@}
            placeholder="Add a todo..."
         />
         <button on:click={todos.add}>Add</button>
         <div>
            <button on:click={() => (filter@.value = "all")}>All</button>
            <button on:click={() => (filter@.value = "active")}>Active</button>
            <button on:click={() => (filter@.value = "completed")}>Completed</button>
         </div>
         <ul>
            {For(filteredTodos@, t => t, todo => (
               <li>
                  <input type="checkbox" mu:checked={todo.completed@} />
                  <span style={(`text-decoration: ${todo.completed ? "line-through" : "none"} `)}>{todo.title}</span>
                  <button on:click={() => todos.remove(todo)}>x</button>
               </li>
            ))}
         </ul>
         <div>
            <span>{(activeTodos.length)} left</span>
            <span> / {todos.length} total</span>
         </div>
      </div>
   );
}

