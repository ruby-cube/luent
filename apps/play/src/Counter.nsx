import { ion, Ion, Ionic, MutableIon } from "@rue/quarky";
import { FromTag, If, template } from "@rue/luent";

// TODO: formatter adds tab between get keyword and variable
// function FractionKit(count@: Ion<number>) {

//       return {
//          get halfCount: ion(() => count / 2),
//          get thirdCount: ion(() => count / 3)
//       }
// }


function FractionKit(count@: Ion<number>) {

   return {
      halfCount@: ion((count / 2)),
      thirdCount@: ion((count / 3))
   }
}

export function NSXCounter({ showFractions@ }: FromTag<{ showFractions: MutableIon<boolean> }>) {

   get count = ion(0, {
      increment() {
         count@.value++
      }
   })
   get doubleCount = ion(() => count * 2)

   const kit = FractionKit(count@);
   get halfCount = kit.halfCount@
   get thirdCount = kit.thirdCount@

   function doSomething(count: number) {
      console.log('count', count)
   }

   doSomething(count)

   function other(count: number) {
      console.log('counter',
         //@ts-expect-error
         cout
      )
   }

   let dog;

   get obj = ion({ name: 'kermit' } as { name: string } | undefined)

   function doSomethingElse() {
      if (dog) {

      }
      else if (obj) {
         const name = obj.name
         console.log('name', obj, name)
      }
      else {
         obj.name
         console.log('nothing')
      }
   }

   doSomethingElse()

   return template(
      <div>
         <button on:click={e => count@.increment()}>+</button>
         <p>start: {count}</p>
         <p>count: {count@}</p>
         <p>doubleCount: {doubleCount@}</p>
         <p>tripleCount: {(count * 3)}</p>
         <button on:click={e => { showFractions@.value = !showFractions; showFractions ? obj@.value = undefined : obj@.value = { name: 'sir robin' } }}>{(showFractions ? 'hide' : 'show')} fractions</button>
         {/* {If(obj,
            <div>{obj.name}</div>
         )}
         {If(obj,
            <div>{(obj.name)}</div>
         )}
         {If(obj, () =>
            <div>{obj.name}</div>
         )}
         {If(obj@,
            <div>{obj.name}</div>
         )}
         {If(obj@,
            <div>{(obj.name)}</div>
         )}
         {If(obj@, () =>
            <div>{obj.name}</div>
         )} */}
         {If(showFractions@, (
            <hr></hr>
            <p> halfCount: {halfCount@}</p>
            <p> thirdCount: {thirdCount@}</p>
         ))}
      </div>
   )
}
