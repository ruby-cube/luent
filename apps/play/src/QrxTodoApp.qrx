
import { asIonic, Ion, Ionic } from "@rue/quarky";
import { For, template } from "@rue/luent";

function RXSTodo() {

   const todos = asIonic([] as Ionic<Todo>[], {
      add(title: string) {
         this.push(IonicTodo(title));
         newTodo@.value = "";
      },
      remove(todo: Ionic<Todo>) {
         const i = this.indexOf(todo);
         if (i !== -1) this.splice(i, 1);
      }
   })

   get newTodo = Ion("");
   get activeTodos = Ion(() => todos.filter(todo => !todo.completed));
   get completedTodos = Ion(() => todos.filter(todo => todo.completed));
   get filter = Ion("all" as 'all' | 'active' | 'completed');
   get filteredTodos = Ion(() => filters[filter]);

   const filters = {
      get all: () => todos,
      get active: activeTodos@,
      get completed: completedTodos@
   }

   return template(
      <div>
         <h2>Todos</h2>
         <input
            mu:value={newTodo@}
            placeholder="Add a todo..."
            on:submit={e => { e.preventDefault(); todos.add(newTodo.trim()) }}
         />
         <button on:click={e => todos.add(newTodo.trim())}>Add</button>
         <div>
            <button on:click={e => (filter@.value = "all")}>All</button>
            <button on:click={e => (filter@.value = "active")}>Active</button>
            <button on:click={e => (filter@.value = "completed")}>Completed</button>
         </div>
         <ul>
            {For(filteredTodos@, t => t, todo => (
               <li>
                  <input type="checkbox" mu:checked={todo.completed@} />
                  <span style={(`text-decoration: ${todo.completed ? "line-through" : "none"} `)}>{todo.title}</span>
                  <button on:click={e => todos.remove(todo)}>x</button>
               </li>
            ))}
         </ul>
         <div>
            <span>{(activeTodos.length)} left</span>
            <span> / {todos.length} total</span>
         </div>
      </div>
   );
}

class Todo {
   constructor(
      public title: string,
      public completed: boolean = false
   ) { }
};

function IonicTodo(title: string) {
   return (
      asIonic(new Todo(title))
   )
}

export {
   RXSTodo
}
