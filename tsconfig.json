{
  "compilerOptions": {
    "plugins": [
      {
        "name": "typescript-plugin-css-modules"
      }
    ],
    "allowImportingTsExtensions": true,
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "allowArbitraryExtensions": true,
    "allowSyntheticDefaultImports": true,
    "lib": [
      "ESNext",
      "DOM"
    ],
    "strict": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@rue/luent",
    "types": [
      "./packages/luent/src/jsx-runtime/index"
    ],
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "noEmit": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": false,
    "skipLibCheck": true,
    "paths": {
      "react/jsx-runtime": [
        "./packages/luent/src/jsx-runtime"
      ],
      "react-dom": [
        "./packages/luent/src/jsx-runtime"
      ],
      "react-dom/*": [
        "./packages/luent/src/jsx-runtime/*"
      ],
      "@rue/utils": [
        "./packages/utils/index.ts"
      ],
      "@rue/luent": [
        "./packages/luent/src/index.ts"
      ],
      "@rue/luent/jsx-runtime": [
        "./packages/luent/src/jsx-runtime/index.ts"
      ],
      "@rue/luent/jsx-dev-runtime": [
        "./packages/luent/src/jsx-runtime/index.ts"
      ],
      "@rue/websites-shared": [
        "./websites/shared/src/index.ts"
      ],
      "@rue/quarky": [
        "./packages/quarky/src/index.ts"
      ],
      "@rue/squirl": [
        "./packages/squirl/src/index.ts"
      ],
      "@rue/quarky/core": [
        "./packages/quarky/src/core/index.ts"
      ],
      "@rue/nextscript": [
        "./packages/nextscript/src/index.ts"
      ],
      "@rue/nextscript/transpile": [
        "./packages/nextscript/src/transpile.ts"
      ],
      "@rue/flask": [
        "./packages/flask/index.ts"
      ],
      "@rue/types": [
        "./packages/types/index.ts"
      ]
    }
  },
  "include": [
    "packages",
    "apps",
    "demos",
    "**/src/*",
    "e2e",
    "plugins",
    "websites/nextscript-site/.vitepress/theme/*",
    "websites/nextscript-site/src/*",
    "websites/nextscript-site/demos/*"
, "websites/shared/tsconfig.json"  ]
}