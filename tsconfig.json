{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": [
      "ESNext",
      "DOM"
    ],
    "moduleResolution": "Node",
    "strict": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@rue",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "noEmit": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": false,
    "skipLibCheck": true,
    "paths": {
      "@rue/utils": [
        "./packages/utils/index.ts"
      ],
      "@rue/jsx-runtime": [
        "./packages/jsx-runtime/core/jsx-runtime.ts"
      ],
      "@rue/jsx-dev-runtime": [
        "./packages/jsx-runtime/core/jsx-runtime.ts"
      ],
      "@rue/actionry": [
        "./packages/actionry/index.ts"
      ],
      "@rue/lumo": [
        "./packages/lumo/src/index.ts"
      ],
      "@rue/muonic": [
        "./packages/muonic/src/index.ts"
      ],
      "@rue/archer": [
        "./packages/archer/index.ts"
      ],
      "@rue/ciel": [
        "./packages/ciel/index.ts"
      ],
      "@rue/dev": [
        "./packages/dev/index.ts"
      ],
      "@rue/ephemr": [
        "./packages/ephemr/index.ts"
      ],
      "@rue/etre": [
        "./packages/etre/index.ts"
      ],
      "@rue/modos": [
        "./packages/modos/index.ts"
      ],
      "@rue/nautic": [
        "./packages/nautic/index.ts"
      ],
      "@rue/paravue": [
        "./packages/paravue/index.ts"
      ],
      "@rue/pecherie": [
        "./packages/pecherie/index.ts"
      ],
      "@rue/flask": [
        "./packages/flask/index.ts"
      ],
      "@rue/thread": [
        "./packages/thread/index.ts"
      ],
      "@rue/turtledom": [
        "./packages/turtledom/index.ts"
      ],
      "@rue/voile": [
        "./packages/voile/index.ts"
      ],
      "@rue/watch": [
        "./packages/watch/index.ts"
      ],
      "@rue/types": [
        "./packages/types/index.ts"
      ]
    },
  },
  "include": [
    "packages",
    "apps",
  ],
  "exclude": [
    "**/x_old",
    "**/old"
  ]
}