{
  "name": "mono-dark",
  "type": "dark",
  "colors": {
    "editor.background": "#141414",
    "editor.foreground": "#cccccc",
    "editorCursor.foreground": "#cfcfcf",
    "editor.selectionBackground": "#2b2b2b",
    "editorLineNumber.foreground": "#5c5c5c"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#7a7a7a",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation",
        "meta.brace",
        "meta.delimiter"
      ],
      "settings": {
        "foreground": "#7a7a7a"
      }
    },
    {
      "scope": [
        "keyword.control",
        "keyword.control.flow",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#a3a3a3"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "meta.tag"
      ],
      "settings": {
        "foreground": "#bdbdbd"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "entity.name.type",
        "entity.name.class",
        "variable",
        "variable.parameter",
        "support.variable",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#cccccc"
      }
    }
  ]
}