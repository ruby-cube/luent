---
import NavBar from "../components/NavBar.astro";

const { wrap } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>Luent — Build with clarity and flow</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&family=Fragment+Mono&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <header class="topbar" id="topbar">
      {
        wrap ? (
          <div class="wrap">
            <NavBar />
          </div>
        ) : (
          <NavBar />
        )
      }
    </header>

    <slot />
  </body>
</html>

<style is:global>
  :root {
    --bg: #fcfcfb;
    --ink: #1c1d22;
    --ink-2: #62646d;
    --line: #e3e4e6;
    --teal: #48bac4;
    --teal-ink: #1e8a94;
    --panel: #f4f5f4;
    --code-bg: #1c1d22;
    --code-ink: #e8e9e6;
    --btn-bg: #48bac4;
    --btn-ink: #10282b;
    --dotc: #cfd1d4;
    --ring: rgba(28, 29, 34, 0.18);
    --nucleus: #48bac4;
  }

 .dark {
    --bg: #0d0f12;
    --ink: #e9eae7;
    --ink-2: #8f929c;
    --line: #23262c;
    --teal: #48bac4;
    --teal-ink: #5cc5ce;
    --panel: #13161a;
    --code-bg: #13161a;
    --code-ink: #d5d7d3;
    --btn-bg: #48bac4;
    --btn-ink: #0d0f12;
    --dotc: #33373e;
    --ring: rgba(233, 234, 231, 0.2);
    --nucleus: #48bac4;
  }

  .light .logo-dark {
    display: none !important;
  }

  .dark .logo-light {
    display: none !important;
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    background: var(--bg);
    color: var(--ink);
    font-family: "Instrument Sans", system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
    transition:
      background 0.25s,
      color 0.25s;
  }

  .mono {
    font-family: "Fragment Mono", monospace;
  }

  .topbar {
    position: sticky;
    top: 0;
    z-index: 60;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
    transition: background 0.25s;
  }

  .wrap {
    max-width: 1250px;
    margin: 0 auto;
    padding: 0 5%;
  }
</style>
