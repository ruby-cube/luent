{
  "scopeName": "nsx.get.injection",
  "injectionSelector": "L:source.tsx -comment -string, L:source.ts -comment -string",
  "patterns": [
    {
      "name": "storage.type",
      "match": "\\bget(?=\\s+[A-Za-z_$][\\w$]*\\s*=)"
    },
    {
      "name": "storage.type",
      "match": "\\bget(?=\\s+[A-Za-z_$][\\w$]*\\s*:)"
    },
    {
      "name": "storage.type",
      "match": "\\bget(?=\\s+[A-Za-z_$][\\w$]*\\s*\\()"
    }
  ]
}
