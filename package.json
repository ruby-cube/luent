{
  "name": "@rue/root",
  "private": true,
  "description": "A collection of TypeScript-enhanced libraries to manage complexity. Covers event-driven architecture, composition, tree structures, and control flow",
  "type": "module",
  "scripts": {
    "build": "pnpm run typecheck && vite build",
    "typecheck": "pnpm run typecheck:quarky",
    "preview": "vite preview",
    "test": "vitest --run --reporter verbose",
    "ni:flask": "pnpm -F @rue/flask install",
    "ni:thread": "pnpm -F @rue/thread install",
    "ni:utils": "pnpm -F @rue/utils install",
    "ni:dev": "pnpm -F @rue/dev install",
    "ni:lumo": "pnpm -F @rue/lumo install",
    "ni:play": "pnpm -F @rue/play install",
    "ni:demos": "pnpm -F @rue/demos install",
    "ni:tests": "pnpm -F @rue/tests install",
    "test-demos": "pnpm exec playwright test --project=chromium",
    "dev": "pnpm -F @rue/play dev",
    "dev-movies": "pnpm -F @rue/movies-app dev",
    "dev-demos": "pnpm -F @rue/demos dev",
    "dev-style": "pnpm -F @rue/demos dev-style",
    "dev-tests": "pnpm -F @rue/tests dev",
    "dev-chat": "pnpm -F @rue/live-chat dev",
    "build-babel": "pnpm -F @rue/play build-babel",
    "ni:quarky": "pnpm -F @rue/quarky install",
    "mu-lint": "pnpm exec tsc apps/play/mu-linting/mu-mutation-linter.ts apps/play/mu-linting/run-mu-mutation-lint.ts --module commonjs --target es2020 --moduleResolution node --skipLibCheck --outDir apps/play/mu-linting/.tmp-run && node apps/play/mu-linting/.tmp-run/run-mu-mutation-lint.js",
    "lint:mu-eslint": "pnpm exec eslint \"apps/play/mu-linting/**/*.{ts,tsx}\"",
    "typecheck:quarky": "pnpm exec node packages/quarky/scripts/quarky-tsc.mjs -p tsconfig.json",
    "test:position-mapping": "pnpm -F @rue/quarky run test:position-mapping"
  },
  "devDependencies": {
    "@rue/quarky-tsserver-plugin": "workspace:*",
    "@typescript-eslint/parser": "^8.46.0",
    "@playwright/test": "^1.58.2",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.13.1",
    "eslint": "^9.38.0",
    "typescript": "^5.7.3",
    "typescript-plugin-css-modules": "^5.2.0",
    "vite": "^6.1.0",
    "vite-plugin-babel": "^1.3.0",
    "vitest": "^3.0.5"
  },
  "author": "Ruby Yi Wang",
  "license": "MIT"
}
