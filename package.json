{
  "name": "@rue/root",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm run typecheck && vite build",
    "typecheck": "pnpm run typecheck:nsx",
    "preview": "vite preview",
    "test": "vitest --run --reporter verbose",
    "ni:flask": "pnpm -F @rue/flask install",
    "ni:utils": "pnpm -F @rue/utils install",
    "ni:luent": "pnpm -F @rue/luent install",
    "ni:jungle": "pnpm -F @rue/jungle install",
    "ni:demos": "pnpm -F @rue/demos install",
    "ni:e2e": "pnpm -F @rue/e2e install",
    "test-demos": "pnpm exec playwright test --config=e2e/playwright.config.ts --project=chromium",
    
    "dev": "pnpm -F @rue/jungle dev",
    "dev-movies": "pnpm -F @rue/movies-app dev",
    "dev-demos": "pnpm -F @rue/demos dev",
    "dev-style": "pnpm -F @rue/demos dev-style",
    "dev-e2e": "pnpm -F @rue/e2e dev",
    "dev-chat": "pnpm -F @rue/live-chat dev",

    "build-babel": "pnpm -F @rue/jungle build-babel",
    "ni:quarky": "pnpm -F @rue/quarky install",
    "mu-lint": "pnpm exec tsc .jungle/mu-linting/mu-mutation-linter.ts .jungle/mu-linting/run-mu-mutation-lint.ts --module commonjs --target es2020 --moduleResolution node --skipLibCheck --outDir .jungle/mu-linting/.tmp-run && node .jungle/mu-linting/.tmp-run/run-mu-mutation-lint.js",
    "lint:mu-eslint": "pnpm exec eslint \".jungle/mu-linting/**/*.{ts,tsx}\""
  },
  "devDependencies": {
    "@rue/eslint-plugin-mu": "workspace:*",
    "@typescript-eslint/parser": "^8.46.0",
    "@playwright/test": "^1.58.2",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^25.5.0",
    "eslint": "^10.1.0",
    "typescript": "^6.0.2",
    "typescript-plugin-css-modules": "^5.2.0",
    "vite": "^8.0.13",
    "vite-plugin-babel": "^1.3.0",
    "vitest": "^4.1.2"
  },
  "pnpm": {
    "overrides": {
      "dompurify@<3.3.2": ">=3.3.2",
      "dompurify@<3.4.0": ">=3.4.0",
      "dompurify@<=3.3.1": ">=3.3.2",
      "dompurify@<=3.3.3": ">=3.4.0",
      "dompurify@>=1.0.10 <3.4.0": ">=3.4.0",
      "dompurify@>=3.0.1 <3.4.0": ">=3.4.0",
      "dompurify@>=3.1.3 <=3.3.1": ">=3.3.2",
      "postcss@<8.5.10": ">=8.5.10"
    }
  },
  "author": "Ruby Yi Wang",
  "license": "MIT"
}
