{
  "name": "@luent/root",
  "private": true,
  "type": "module",
  "scripts": {
    "i:stable": "pnpm -r --filter '!./.jungle/**' install",
    "install:workspace": "pnpm -r install",
    "build": "pnpm run typecheck && vite build",
    "typecheck": "pnpm run typecheck:nsx",
    "preview": "vite preview",
    "test": "vitest --run --reporter verbose",
    "i:demos": "pnpm -r --filter @luent/demos install",
    "i:luent-site": "pnpm -r --filter @luent/luent-site install",
    "i:luent": "pnpm -r --filter luent install",
    "i:flask": "pnpm -r --filter @luent/flask install",
    "i:quarky": "pnpm -r --filter @luent/quarky install",
    "i:tree-squirl": "pnpm -r --filter @luent/tree-squirl install",
    "i:nextscript": "pnpm -r --filter @luent/nextscript install",
    "i:nextscript-site": "pnpm -r --filter @luent/nextscript-site install",
    "i:utils": "pnpm -r --filter @luent/utils install",
    "i:jungle": "pnpm -r --filter './.jungle/**' install",
    "i:e2e": "pnpm -r --filter @luent/e2e install",
    "test:demos": "pnpm exec playwright test --config=e2e/playwright.config.ts --project=chromium",
    "dev": "pnpm -F @luent/jungle dev",
    "dev-movies": "pnpm -F @luent/movies-app dev",
    "dev:demos": "pnpm -F @luent/demos dev",
    "dev:style": "pnpm -F @luent/demos dev-style",
    "dev:e2e": "pnpm -F @luent/e2e dev",
    "dev:chat": "pnpm -F @luent/live-chat dev",
    "dev:ns-site": "pnpm -F @luent/nextscript-site docs:dev",
    "dev:luent-site": "pnpm -F @luent/luent-site docs:dev",
    "dev:luent-docs": "pnpm -F luent-docs dev",
    "prep:luent:publish": "pnpm --dir packages/luent run prep:publish",
    "build:ns-site": "pnpm -F @luent/nextscript-site docs:build",
    "build:luent-site": "pnpm -F @luent/luent-site docs:build",
    "preview:ns-site": "pnpm -F @luent/nextscript-site docs:preview",
    "preview:luent-site": "pnpm -F @luent/luent-site docs:preview",
    "build-babel": "pnpm -F @luent/jungle build-babel",
    "mu-lint": "pnpm exec tsc .jungle/mu-linting/mu-mutation-linter.ts .jungle/mu-linting/run-mu-mutation-lint.ts --module commonjs --target es2020 --moduleResolution node --skipLibCheck --outDir .jungle/mu-linting/.tmp-run && node .jungle/mu-linting/.tmp-run/run-mu-mutation-lint.js",
    "lint:mu-eslint": "pnpm exec eslint \".jungle/mu-linting/**/*.{ts,tsx}\""
  },
  "devDependencies": {
    "@luent/eslint-plugin-mu": "workspace:*",
    "@typescript-eslint/parser": "^8.46.0",
    "@playwright/test": "^1.58.2",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^25.5.0",
    "eslint": "^10.1.0",
    "typescript": "^6.0.2",
    "typescript-plugin-css-modules": "^5.2.0",
    "vite": "^8.1.3",
    "vite-plugin-babel": "^1.3.0",
    "vitest": "^4.1.2"
  },
  "author": "Ruby Yi Wang",
  "license": "MIT",
  "packageManager": "pnpm@11.10.0"
}
