{
  "name": "@rue/root",
  "private": true,
  "description": "A collection of TypeScript-enhanced libraries to manage complexity. Covers event-driven architecture, composition, tree structures, and control flow",
  "type": "module",
  "scripts": {
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest --run --reporter verbose",
    "ni:pecherie": "pnpm -F @rue/pecherie install",
    "ni:actionry": "pnpm -F @rue/actionry install",
    "ni:archer": "pnpm -F @rue/archer install",
    "ni:etre": "pnpm -F @rue/etre install",
    "ni:modos": "pnpm -F @rue/modos install",
    "ni:nautic": "pnpm -F @rue/nautic install",
    "ni:paravue": "pnpm -F @rue/paravue install",
    "ni:flask": "pnpm -F @rue/flask install",
    "ni:ruelle": "pnpm -F @rue/ruelle install",
    "ni:thread": "pnpm -F @rue/thread install",
    "ni:turtledom": "pnpm -F @rue/turtledom install",
    "ni:utils": "pnpm -F @rue/utils install",
    "ni:dev": "pnpm -F @rue/dev install",
    "ni:voile": "pnpm -F @rue/voile install",
    "ni:ciel": "pnpm -F @rue/ciel install",
    "ni:ephemr": "pnpm -F @rue/ephemr install",
    "ni:watch": "pnpm -F @rue/watch install",
    "ni:signals": "pnpm -F @rue/signals install",
    "ni:lumo": "pnpm -F @rue/lumo install",
    "ni:play": "pnpm -F @rue/play install",
    "ni:demos": "pnpm -F @rue/demos install",
    "dev": "pnpm -F @rue/play dev",
    "dev-demos": "pnpm -F @rue/demos dev",
    "dev-chat": "pnpm -F @rue/live-chat dev",
    "build-babel": "pnpm -F @rue/play build-babel",
    "ni:quarky": "pnpm -F @rue/quarky install"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.13.1",
    "typescript": "^5.7.3",
    "typescript-plugin-css-modules": "^5.2.0",
    "vite": "^6.1.0",
    "vite-plugin-babel": "^1.3.0",
    "vitest": "^3.0.5"
  },
  "author": "Ruby Yi Wang",
  "license": "MIT"
}