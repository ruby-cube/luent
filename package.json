{
  "name": "@luent/root",
  "private": true,
  "type": "module",
  "scripts": {
    "install:workspace": "pnpm -r install",
    "build": "pnpm run typecheck && vite build",
    "typecheck": "pnpm run typecheck:nsx",
    "preview": "vite preview",
    "test": "vitest --run --reporter verbose --exclude '**/e2e/**'",
    "i:demos": "pnpm -r --filter @luent/demos install",
    "i:luent-site": "pnpm -r --filter @luent/luent-site install",
    "i:luent": "pnpm -r --filter luent install",
    "i:flask": "pnpm -r --filter @luent/flask install",
    "i:quarky": "pnpm -r --filter @luent/quarky install",
    "i:tree-squirl": "pnpm -r --filter @luent/tree-squirl install",
    "i:noriscript": "pnpm -r --filter @luent/noriscript install",
    "i:noriscript-site": "pnpm -r --filter @luent/noriscript-site install",
    "i:utils": "pnpm -r --filter @luent/utils install",
    "i:e2e": "pnpm -r --filter @luent/e2e install",
    "test:demos": "pnpm exec playwright test --config=e2e/playwright.config.ts --project=chromium",
    "dev:demos": "pnpm -F @luent/demos dev",
    "dev:e2e": "pnpm -F @luent/e2e dev",
    "dev:ns-site": "pnpm -F @luent/noriscript-site docs:dev",
    "dev:luent-site": "pnpm -F @luent/luent-site docs:dev",
    "prep:luent:publish": "pnpm --dir packages/luent run prep:publish",
    "build:ns-site": "pnpm -F @luent/noriscript-site docs:build",
    "build:luent-site": "pnpm -F @luent/luent-site docs:build",
    "preview:ns-site": "pnpm -F @luent/noriscript-site docs:preview",
    "preview:luent-site": "pnpm -F @luent/luent-site docs:preview"
  },
  "devDependencies": {
    "@luent/eslint-plugin-mu": "workspace:*",
    "@typescript-eslint/parser": "^8.46.0",
    "@playwright/test": "^1.58.2",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^25.5.0",
    "eslint": "^10.1.0",
    "typescript": "^6.0.2",
    "typescript-plugin-css-modules": "^5.2.0",
    "vite": "^8.1.3",
    "vite-plugin-babel": "^1.3.0",
    "vitest": "^4.1.2"
  },
  "author": "Ruby Yi Wang",
  "license": "MIT",
  "packageManager": "pnpm@11.10.0"
}
